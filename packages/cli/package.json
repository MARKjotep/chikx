{
  "name": "@chikx/cli",
  "version": "0.1.0",
  "description": "Chikx command line interface: build, check, watch, format and clean.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MARKjotep/chikx.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MARKjotep/chikx#readme",
  "bugs": {
    "url": "https://github.com/MARKjotep/chikx/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chikx/compiler": "0.1.0"
  },
  "bin": {
    "chikx": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  }
}
