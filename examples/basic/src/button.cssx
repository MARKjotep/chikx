@setup {
  prefix: "ui";
  css-dir: "../generated/styles";
  css-name: "button.css";
  map-dir: "../generated/maps";
  map-name: "button.map.js";
}

@use "./theme.cssx" as theme;

@variables {
  spacing: 12px;
  radius: 8px;
}

@runtime {
  colors: orange @dark #4EC9B0;
}

.button {
  padding: $spacing @md 20px @xl 32px;
  border-radius: $radius;
  background: $theme.primary @dark #1e70af;
  font-size: 14px @md 16px;

  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  & > .icon {
    width: 16px @lg 20px;
  }
}

.test {
  color: orange;
  background-color: green;

  &:after {
    cursor: pointer;
    background-color: #000000;
  }

  &:hover {
  }

  &:focus {
  }
}

@keyframes ss {
  from {
    background-color: $radius;
  }

  100% {
    padding: 1rem 2px;
  }
}
